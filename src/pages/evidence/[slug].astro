---
import Layout from '../../layouts/Layout.astro';
import { evidenceData } from '../../components/data/evidenceData';

export async function getStaticPaths() {
  return evidenceData.flatMap(category =>
    category.files.map(file => ({
      params: {
        slug: file.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')
      },
      props: { file, category }
    }))
  );
}

const { file, category } = Astro.props;
---

<Layout title={`${file.name} | Evidencia`}>
  <main class="detail-page">
    <div class="detail-card">
      <a href="/#evidences" class="back-btn">← Volver al portafolio</a>

      <div class="detail-header">
        <span class="detail-category" style={`--accent:${category.color}`}>
          {category.category}
        </span>
        <h1>{file.name}</h1>
        <p>{file.description}</p>
      </div>

      <div class="detail-grid">
        <section>
          <h2>Descripción detallada</h2>
          <p>{file.details}</p>
        </section>

        <aside>
          <div class="meta-box">
            <h3>Información</h3>
            <ul>
              <li><strong>Tipo:</strong> {file.type}</li>
              <li><strong>Fecha:</strong> {file.date}</li>
              <li><strong>Categoría:</strong> {category.category}</li>
            </ul>
          </div>

          <div class="meta-box">
            <h3>Tecnologías / Temas</h3>
            <div class="tags">
              {file.tags?.map(tag => <span>{tag}</span>)}
            </div>
          </div>
        </aside>
      </div>

      <div class="detail-actions">
        <a href={file.file} target="_blank">Descargar evidencia</a>
      </div>
    </div>
  </main>
</Layout>

<style>
.detail-page {
min-height:100vh;
padding:4rem 2rem;
display:flex;
justify-content:center;
background:#09090d;
}
.detail-card {
max-width:1100px;
width:100%;
background:#111217;
border:1px solid #23232f;
border-radius:28px;
padding:3rem;
}
.back-btn { color:#b7a7ff; text-decoration:none; }
.detail-header h1 { font-size:4rem; color:white; margin:1rem 0; }
.detail-header p { font-size:1.6rem; color:#aaa; line-height:1.7; }
.detail-category {
 display:inline-flex; padding:.8rem 1.2rem; border-radius:999px;
 background:color-mix(in srgb,var(--accent) 15%,transparent);
 color:var(--accent);
}
.detail-grid { display:grid; grid-template-columns:2fr 1fr; gap:2rem; margin-top:3rem; }
.detail-grid h2, .meta-box h3 { color:white; margin-bottom:1rem; }
.detail-grid p, .meta-box li { color:#b0b0bc; font-size:1.5rem; line-height:1.8; }
.meta-box {
background:#171822; border:1px solid #2a2b38; border-radius:20px; padding:1.8rem; margin-bottom:1.5rem;
}
.tags { display:flex; flex-wrap:wrap; gap:.8rem; }
.tags span {
background:rgba(255,255,255,.05); padding:.6rem 1rem; border-radius:999px; color:#ddd;
}
.detail-actions { margin-top:3rem; }
.detail-actions a {
 display:inline-flex; padding:1.2rem 1.8rem; border-radius:14px; background:#8664ee; color:white; text-decoration:none;
}
@media (max-width: 768px){
.detail-grid { grid-template-columns:1fr; }
.detail-header h1 { font-size:2.8rem; }
.detail-card { padding:2rem; }
}
</style>
