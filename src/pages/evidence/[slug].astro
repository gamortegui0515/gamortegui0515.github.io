<script>
  document.querySelectorAll('[data-code-src]').forEach(async (block) => {
    const target = block as HTMLElement;
    const src = target.dataset.codeSrc;
    if (!src) return;

    try {
      const response = await fetch(src);
      if (!response.ok) throw new Error('No se pudo cargar el archivo');
      const text = await response.text();
      target.textContent = text.slice(0, 20000);
    } catch {
      target.textContent = 'No se pudo cargar la vista previa del script SQL.';
    }
  });
</script>

