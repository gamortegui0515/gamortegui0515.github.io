---
import './hero.css';
import Boton from '../atoms/Boton.astro';
---

<section class="hero">
	<div class="hero__container">
		<div class="text__content">
			<h1 class="hero__title color__gradiente">Gabriel Amortegui</h1>
			<p class="hero__text">
				Soy estudiante de Ingeniería en Sistemas, apasionado por la tecnología y el aprendizaje constante.
			</p>
			<div class="hero__buttons">
				<Boton href="#presentacion" texto="Sobre mí"/>
				<Boton href="#evidences" texto="Ver evidencias"/>
			</div>
		</div>
		<img
			class="hero__img"
			src="/img/gabriel-amortegui.png"
			alt="gabriel_amortegui_img"
			width="384"
			height="384"
		/>
	</div>
</section>

<style>
	.hero__buttons {
		display: flex;
		gap: 1.6rem;
		flex-wrap: wrap;
	}
	.hero__buttons :global(a:last-child) {
		background: transparent;
		border: 2px solid var(--primary-60);
		color: var(--primary-90);
	}
	.hero__buttons :global(a:last-child:hover) {
		background: rgba(102, 50, 207, 0.15);
		opacity: 1;
	}
</style>
