---
import './hero.css';
import Boton from '../atoms/Boton.astro';
---

<section class="hero">
  <div class="hero__container">
    <div class="text__content">
      <span class="hero__badge">Portafolio Academico - Bases de Datos</span>
      <h1 class="hero__title color__gradiente">Gabriel Amortegui</h1>
      <p class="hero__text">
        Soy estudiante de Ingenieria en Sistemas, apasionado por la tecnologia, el desarrollo de software y el aprendizaje constante. En este portafolio reuno las evidencias de Bases de Datos 1: modelado, normalizacion, algebra relacional, SQL y el proyecto final UB Deporte.
      </p>
      <div class="hero__stats">
        <div><strong>25+</strong><span>Evidencias</span></div>
        <div><strong>SQL</strong><span>Scripts y consultas</span></div>
        <div><strong>MER</strong><span>Modelado de datos</span></div>
      </div>
      <div class="hero__buttons">
        <Boton href="#presentacion" texto="Sobre mi" />
        <Boton href="#evidences" texto="Explorar evidencias" />
      </div>
    </div>
    <img
      class="hero__img"
      src="/img/gabriel-amortegui.png"
      alt="Gabriel Amortegui"
      width="384"
      height="384"
    />
  </div>
</section>

<style>
  .hero__badge {
    display: inline-flex;
    width: fit-content;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: rgba(134, 100, 238, 0.12);
    border: 1px solid rgba(134, 100, 238, 0.35);
    font-size: 1.2rem;
    color: #c7bbff;
  }
  .hero__buttons {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .hero__stats {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .hero__stats div {
    padding: 1rem 1.4rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 120px;
  }
  .hero__stats strong {
    display: block;
    font-size: 1.8rem;
    color: white;
  }
  .hero__stats span {
    font-size: 1.1rem;
    color: #9a9aaf;
  }
  .hero__buttons :global(a:last-child) {
    background: transparent;
    border: 2px solid var(--primary-60);
    color: var(--primary-90);
  }
  .hero__buttons :global(a:last-child:hover) {
    background: rgba(102, 50, 207, 0.15);
    opacity: 1;
  }
</style>
