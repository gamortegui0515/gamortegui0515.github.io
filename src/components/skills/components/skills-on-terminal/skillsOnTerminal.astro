---
import TerminalIcon from '../../atoms/terminal-icon/TerminalIcon.astro';
import Terminal from '../terminal/Terminal.astro';
import './skills-on-terminal.css';
---

<Terminal nombre="gabriel">
	<div class="terminal__skills">
		<h2>Habilidades</h2>
		<div class="terminal__skills__container">
			<TerminalIcon
				src="/assets/mysql.svg"
				color="#00758F"
				name="MySQL"
			/>
			<TerminalIcon
				src="/assets/javascript.svg"
				color="#F7DF1E"
				name="JavaScript"
			/>
			<TerminalIcon
				src="/assets/html.svg"
				color="#E34F26"
				name="HTML"
			/>
			<TerminalIcon
				src="/assets/css.svg"
				color="#00A3FF"
				name="CSS"
			/>
			<TerminalIcon
				src="/assets/react.svg"
				color="#00D1FF"
				name="React"
			/>
			<TerminalIcon
				src="/assets/Astro.svg"
				color="#FF5D01"
				name="Astro"
			/>
			<TerminalIcon
				src="/assets/mongodb.svg"
				color="#47A248"
				name="MongoDB"
			/>
			<TerminalIcon
				src="/assets/nodejs.svg"
				color="#539E43"
				name="Node.js"
			/>
		</div>
	</div>
</Terminal>
