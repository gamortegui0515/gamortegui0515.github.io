const groupFiles = (files) => {
	const groups = new Map();
	files.forEach((file) => {
		const groupName = file.group || 'General';
		if (!groups.has(groupName)) groups.set(groupName, []);
		groups.get(groupName).push(file);
	});
	return Array.from(groups, ([name, items]) => ({ name, items }));
};
